{
  "info": {
    "name": "KitchenKeys Cloud Kitchen API",
    "description": "Run folders 0 to 4 in order with the Collection Runner. Start from an empty database (delete kitchenkeys.db and restart the server).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "0. Setup (run on an empty database)",
      "item": [
        {
          "name": "Create chef Asha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chefs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chefs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Rao\",\n  \"email\": \"asha@kitchenkeys.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('chefId', pm.response.json().id);"
